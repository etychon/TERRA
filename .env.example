# Copy to `.env` and adjust. Docker Compose reads these automatically from `.env` in the same directory.
# Never commit a real `.env` with production secrets.

# User-facing WebUI (nginx TLS): https://localhost:${TERRA_HTTPS_PORT}
TERRA_HTTPS_PORT=4434

TERRA_SECRET_KEY=replace-with-at-least-32-characters-random-string
TERRA_ADMIN_EMAIL=admin@terra.local
TERRA_ADMIN_PASSWORD=ChangeMe!Admin-1st-login
TERRA_MAIL_MODE=log

# Inventory sync: merge per-device interface/cellular dataservice rows into raw_json (default true).
# TERRA_SDWAN_SYNC_ENRICH_DEVICE_DETAILS=false
# TERRA_SDWAN_SYNC_ENRICH_MAX_INVENTORY_DEVICES=400
# TERRA_SDWAN_SYNC_ENRICH_REQUEST_TIMEOUT_SECONDS=8
# Parallel per-device enrich sessions when using JWT and single-tenant inventory (default 6; session or multitenant forces 1).
# TERRA_SDWAN_SYNC_ENRICH_CONCURRENCY=6
# Inventory list / tenant API timeout during sync (seconds; default 120).
# TERRA_SDWAN_SYNC_INVENTORY_TIMEOUT_SECONDS=120
# Max concurrent Manager syncs in periodic batch and bulk user sync (default 3; lower if SQLite locks).
# TERRA_SDWAN_BATCH_MAX_CONCURRENT_MANAGERS=3
# Device detail “Show live data” browser polling (defaults usually fine).
# TERRA_DEVICE_LIVE_POLL_INTERVAL_SECONDS=5
# TERRA_DEVICE_LIVE_HTTP_TIMEOUT_SECONDS=25.0

# Behind the TLS edge proxy (Compose): Secure session cookies + trust X-Forwarded-Proto.
TERRA_SESSION_COOKIE_SECURE=true
TERRA_FORWARDED_ALLOW_IPS=*

# --- Compose data tier (defaults are baked into docker-compose.yml for dev) ---
# TERRA_POSTGRES_USER=terra
# TERRA_POSTGRES_PASSWORD=terradb-dev-password
# TERRA_POSTGRES_DB=terra
# TERRA_DATABASE_URL=postgresql+psycopg://terra:terradb-dev-password@postgres:5432/terra
# TERRA_VICTORIAMETRICS_URL=http://victoriametrics:8428
# TERRA_TELEMETRY_PUSH_ENABLED=true
# EIOLTE cellular history (after each inventory sync; requires VictoriaMetrics).
# TERRA_CELLULAR_HISTORY_ENABLED=true
# TERRA_CELLULAR_HISTORY_HOURS=2
# TERRA_CELLULAR_HISTORY_BACKFILL_HOURS=48
# TERRA_CELLULAR_HISTORY_HISTOGRAM_MINUTES=30
# TERRA_CELLULAR_HISTORY_MAX_DEVICES_PER_SYNC=200
# TERRA_CELLULAR_RSSI_QUALITY_THRESHOLDS_DBM=-65,-75,-85
# Core disables periodic sync; collector enables it (see specs/architecture.md).
# TERRA_SDWAN_BACKGROUND_SYNC=false

# --- Optional: Grafana (docker compose --profile grafana up -d) ---
# TERRA_GRAFANA_PORT=3000
# TERRA_GRAFANA_ADMIN_USER=admin
# TERRA_GRAFANA_ADMIN_PASSWORD=admin

# --- Optional: Docker debug overlay (docker-compose.debug.yml) ---
# Long random string; required for /debug/* when TERRA_DEBUG_EXPOSE_INTERNALS is true.
# TERRA_DEBUG_TOKEN=
# Host port for debug API (default 18434; avoids host 8000).
# TERRA_DEBUG_API_PORT=18434
# Listen address: 0.0.0.0 = LAN reachable (e.g. http://192.168.2.3:18434); 127.0.0.1 = loopback only.
# TERRA_DEBUG_HOST_BIND=0.0.0.0
